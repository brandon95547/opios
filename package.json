{
  "name": "opios",
  "version": "0.1.0",
  "private": true,
  "description": "A simple newsletter system: contacts, templates, messages, sent through your own Gmail or SMTP account.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/*.test.js",
    "reset-password": "node server/reset-password.js"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "express": "5.3.0",
    "juice": "12.2.0",
    "lucide-react": "1.56.0",
    "mjml": "5.4.1",
    "mjml-browser": "5.4.1",
    "nodemailer": "10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "smtp-server": "3.19.24",
    "vite": "8.3.4"
  }
}
