# Copy to .env to change any of these. All are optional.

# The port Opios listens on.
PORT=5340

# 127.0.0.1 keeps Opios reachable from this computer only. Leave it as is behind a proxy
# such as nginx; 0.0.0.0 opens it to the network.
HOST=127.0.0.1

# Where the database and the encryption key live. Back this folder up.
# OPIOS_DATA_DIR=/var/lib/opios

# The key that encrypts the saved email password. If unset, one is made in the data folder
# (secret.key). Set it to any long random string to keep the key out of that folder.
# OPIOS_SECRET=
