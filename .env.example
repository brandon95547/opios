# Copy to .env to change any of these. All are optional.

# The port Opios listens on.
PORT=5340

# 127.0.0.1 keeps Opios reachable from this computer only. Leave it as is behind a proxy
# such as nginx; 0.0.0.0 opens it to the network.
HOST=127.0.0.1

# Where the database and the encryption key live. Back this folder up.
# OPIOS_DATA_DIR=/var/lib/opios

# The key that encrypts the saved email password. If unset, one is made in the data folder
# (secret.key). Set it to any long random string to keep the key out of that folder.
# OPIOS_SECRET=

# The path Opios is served under when it shares a domain, such as /opios. Leave it empty to
# serve Opios at the root. It is built in, so run `npm run build` after changing it.
# OPIOS_BASE_PATH=/opios

# On a server, the first visit could be anyone's, so creating the login there needs this code.
# Without it, the login is made with `npm run reset-password` on the server instead. It does
# nothing once the login exists.
# OPIOS_SETUP_CODE=

# Which proxies to believe about the visitor's address and https. The default, "loopback,
# uniquelocal", is this computer and private networks (Docker's among them).
# OPIOS_TRUST_PROXY=loopback, uniquelocal
